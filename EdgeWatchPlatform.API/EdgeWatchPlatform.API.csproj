<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- EntityFrameworkCore database persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MySQL provider -->
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <!-- Naming conventions -->
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <!-- OpenAPI documentation -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <!-- Password hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- JSON Web Tokens -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <!-- Mediator pattern (domain events and command pipeline) -->
    <PackageReference Include="Cortex.Mediator" Version="3.1.2" />
  </ItemGroup>

</Project>
